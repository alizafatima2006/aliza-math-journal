---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}

const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;

const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const formattedDate = published.toLocaleDateString("en-CA", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const { remarkPluginFrontmatter } = await entry.render();
---

<article
	class:list={["journal-entry", className]}
	style={style}
>
	<div class="journal-entry__header">
		<div class="journal-entry__type">
			{category || "Article"}
		</div>

		<time datetime={published.toISOString()}>
			{formattedDate}
		</time>
	</div>

	<a class="journal-entry__title" href={url}>
		{title}
	</a>

	<p class="journal-entry__description">
		{description || remarkPluginFrontmatter.excerpt}
	</p>

	<div class="journal-entry__footer">
		<div class="journal-entry__tags">
			{tags.map((tag) => <span>{tag}</span>)}
		</div>

		<div class="journal-entry__reading">
			{remarkPluginFrontmatter.minutes}
			{remarkPluginFrontmatter.minutes === 1 ? " minute" : " minutes"}
		</div>
	</div>

	{
		hasCover && (
			<a class="journal-entry__cover" href={url} aria-label={title}>
				<ImageWrapper
					src={image}
					basePath={path.join("content/posts/", getDir(entry.id))}
					alt={`Cover image for ${title}`}
				/>
			</a>
		)
	}
</article>

<style>
	.journal-entry {
		position: relative;
		width: 100%;
		padding: 2.25rem 2.25rem;
	border-bottom: 1px solid var(--journal-rule, #d8d8d1);
	border-radius: 0;
	box-shadow: none;
	background: var(--journal-paper);
}

	.journal-entry:first-child {
		border-top: 1px solid var(--journal-rule, #d8d8d1);
	}

	.journal-entry__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--journal-muted, #686b70);
	}

	.journal-entry__type {
		color: var(--journal-navy, #0b1f3a);
	}

	.journal-entry__title {
		display: inline-block;
		margin: 0;
		color: var(--journal-ink, #202124);
		font-family: var(--font-journal);
		font-size: clamp(1.65rem, 3vw, 2.25rem);
		font-weight: 520;
		line-height: 1.15;
		letter-spacing: -0.018em;
		text-decoration: none;
	}

	.journal-entry__title:hover {
		color: var(--journal-navy, #0b1f3a);
	}

	.journal-entry__description {
		max-width: 42rem;
		margin: 0.9rem 0 1.1rem;
		color: var(--journal-muted, #686b70);
		font-size: 1.03rem;
		line-height: 1.65;
	}

	.journal-entry__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		font-size: 0.84rem;
		color: var(--journal-muted, #686b70);
	}

	.journal-entry__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.journal-entry__tags span:not(:last-child)::after {
		content: "·";
		margin-left: 0.75rem;
		color: var(--journal-rule, #d8d8d1);
	}

	.journal-entry__reading {
		flex-shrink: 0;
	}

	.journal-entry__cover {
		display: block;
		margin-top: 1.5rem;
		max-width: 18rem;
	}

	@media (max-width: 640px) {
		.journal-entry {
			padding: 1.75rem 1.25rem;
		}

		.journal-entry__header,
		.journal-entry__footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.journal-entry__title {
			font-size: 1.65rem;
		}
	}
</style>

