---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---
<header class="journal-masthead">

	<h1>Notes on Mathematics</h1>

	<p class="journal-masthead__subtitle">
		A collection of expository articles and research notes exploring
		probability, mathematical finance, and pure mathematics.
	</p>

    <nav class="journal-sections" aria-label="Journal sections">
	<a href={url("/articles/")}>Articles</a>
	<a href={url("/research-notes/")}>Research Notes</a>
	<a href={url("/problems-and-paradoxes/")}>Problems &amp; Paradoxes</a>
	<a href={url("/collected-works/")}>Collected Works</a>
</nav>
</header>

<!--
<div class="journal-list transition flex flex-col mb-4">
	{
		page.data.map((entry: CollectionEntry<"posts">) => (
			<PostCard
				entry={entry}
				title={entry.data.title}
				tags={entry.data.tags}
				category={entry.data.category}
				published={entry.data.published}
				updated={entry.data.updated}
				url={getPostUrlBySlug(entry.slug)}
				image={entry.data.image}
				description={entry.data.description}
				draft={entry.data.draft}
