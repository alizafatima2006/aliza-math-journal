<style>
	.journal-list {
		width: 100%;
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

    .journal-masthead {
	max-width: 58rem;
	margin: 0 auto;
	padding: 5rem 3rem 4rem;

	text-align: center;
}

.journal-masthead h1 {
	margin: 0;
	color: var(--journal-ink);
	font-family: var(--font-journal);
	font-size: clamp(3rem, 7vw, 5.25rem);
	font-weight: 460;
	line-height: 0.98;
	letter-spacing: -0.032em;
}

.journal-masthead__subtitle {
	max-width: 40rem;
	margin: 1.5rem auto 0;

	color: var(--journal-muted);

	font-size: 1.15rem;
	line-height: 1.75;
}

.journal-sections {
	display: flex;
	justify-content: center;
	flex-wrap: wrap;
	gap: 2.5rem;
	margin-top: 2.5rem;
	padding-top: 1.5rem;
	border-top: 1px solid var(--journal-rule);
	font-size: 0.9rem;
	font-weight: 600;
	letter-spacing: 0.04em;
}

.journal-sections a {
	color: var(--journal-ink);
	text-decoration: none;
}

.journal-sections a:hover {
	color: var(--journal-navy);
}

@media (max-width: 640px) {
	.journal-masthead {
		padding: 3rem 1.5rem 2.75rem;
	}

	.journal-masthead h1 {
		font-size: 3rem;
	}

	.journal-sections {
		flex-direction: column;
		gap: 0.8rem;
	}
}

</style>
