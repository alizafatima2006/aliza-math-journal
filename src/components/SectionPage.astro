---
import { url } from "../utils/url-utils";

interface Props {
	title: string;
	description: string;
	emptyMessage?: string;
}

const {
	title,
	description,
	emptyMessage,
} = Astro.props;
---

<main class="section-page">
	<a class="back-home" href={url("/")}>
		<span aria-hidden="true">←</span>
		Notes on Mathematics
	</a>

	<header class="section-page__header">
		<p class="section-page__kicker">Notes on Mathematics</p>

		<h1>{title}</h1>

		<p class="section-page__description">
			{description}
		</p>
	</header>

	<div class="section-page__content">
		<slot />

		{
			emptyMessage && (
				<div class="section-empty">
					<p>{emptyMessage}</p>
				</div>
			)
		}
	</div>
</main>

<style>
	.section-page {
		/* Light mode colours */
		--section-ink: #202124;
		--section-muted: #66686d;
		--section-accent: #172b4d;
		--section-paper: #f7f3e8;
		--section-rule: #d7d0c3;

		width: 100%;
		min-height: 60vh;
		padding: 5rem 3rem;

		background: var(--section-paper);
		color: var(--section-ink);

		font-family:
			"Source Serif 4 Variable",
			Georgia,
			"Times New Roman",
			serif;
	}

	:global(html.dark) .section-page {
		/* Dark mode colours */
		--section-ink: #eeeae2;
		--section-muted: #b9b4ac;
		--section-accent: #aabbd4;
		--section-paper: #090c10;
		--section-rule: #2a3038;
	}

	.back-home {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 3rem;

		color: var(--section-muted);
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.back-home:hover {
		color: var(--section-accent);
	}

	.back-home span {
		transition: transform 160ms ease;
	}

	.back-home:hover span {
		transform: translateX(-0.2rem);
	}

	.section-page__header {
		max-width: 48rem;
		margin: 0 auto 4rem;
		text-align: center;
	}

	.section-page__kicker {
		margin: 0 0 1rem;

		color: var(--section-accent);

		font-size: 0.76rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.section-page h1 {
		margin: 0;

		color: var(--section-ink);

		font-size: clamp(2.75rem, 6vw, 4.5rem);
		font-weight: 470;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.section-page__description {
		max-width: 38rem;
		margin: 1.5rem auto 0;

		color: var(--section-muted);

		font-size: 1.12rem;
		line-height: 1.7;
	}

	.section-page__content {
		max-width: 58rem;
		margin: 0 auto;
	}

	.section-empty {
		padding: 3rem 0;

		border-top: 1px solid var(--section-rule);
		border-bottom: 1px solid var(--section-rule);

		color: var(--section-muted);
		text-align: center;
	}

	.section-empty p {
		margin: 0;
	}

	@media (max-width: 640px) {
		.section-page {
			padding: 3rem 1.5rem;
		}

		.section-page__header {
			margin-bottom: 2.75rem;
		}
	}
</style>