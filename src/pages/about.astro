---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---

<MainGridLayout
	title={i18n(I18nKey.about)}
	description={i18n(I18nKey.about)}
>
	<main class="about-page">
		<a class="about-back" href={url("/")}>
			<span aria-hidden="true">←</span>
			Notes on Mathematics
		</a>

		<header class="about-header">
			<p class="about-kicker">Notes on Mathematics</p>
			<h1>About</h1>
		</header>

		<div class="about-content">
			<Markdown class="about-markdown">
				<Content />
			</Markdown>
		</div>
	</main>
</MainGridLayout>

<style>
	.about-page {
		width: 100%;
		min-height: 60vh;
		padding: 5rem 3rem;
		font-family:
			"Source Serif 4 Variable",
			Georgia,
			"Times New Roman",
			serif;
	}

	.about-back {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 3rem;

		color: var(--journal-muted);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.about-back:hover {
		color: var(--journal-navy);
	}

	.about-back span {
		transition: transform 160ms ease;
	}

	.about-back:hover span {
		transform: translateX(-0.2rem);
	}

	.about-header {
		max-width: 48rem;
		margin: 0 auto 3.5rem;
		text-align: center;
	}

	.about-kicker {
		margin: 0 0 1rem;
		color: var(--journal-navy);
		font-size: 0.76rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.about-header h1 {
		margin: 0;
		color: var(--journal-ink);
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		font-weight: 470;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.about-content {
		max-width: 43rem;
		margin: 0 auto;
	}

	:global(.about-markdown) {
		color: var(--journal-ink);
		font-size: 1.08rem;
		line-height: 1.78;
	}

	:global(.about-markdown p) {
		color: var(--journal-ink) !important;
		-webkit-text-fill-color: var(--journal-ink);
		margin: 0 0 1.15rem;
	}

	:global(.about-markdown h2) {
		margin-top: 2.5rem;
		color: var(--journal-ink) !important;
		font-size: 1.7rem;
		font-weight: 560;
	}

	:global(.about-markdown a) {
		color: var(--journal-navy) !important;
		text-underline-offset: 0.15em;
	}

	@media (max-width: 640px) {
		.about-page {
			padding: 3rem 1.5rem;
		}

		.about-header {
			margin-bottom: 2.75rem;
		}
	}
</style>