---
/* This Page Contains the Code for the Articles themselves */

import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import { profileConfig, siteConfig } from "../../config";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const { remarkPluginFrontmatter } = await entry.render();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
---
<MainGridLayout
	banner={entry.data.image}
	title={entry.data.title}
	description={entry.data.description}
	lang={entry.data.lang}
	setOGTypeArticle={true}
	headings={headings}
>
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	></script>

	<article class="article-shell">
		<a class="article-back" href="/articles/">
			<span aria-hidden="true">←</span>
			Expository Articles
		</a>

		<header class="article-header">
			<p class="article-type">
				{entry.data.category || "Expository Article"}
			</p>

			<h1
				data-pagefind-body
				data-pagefind-weight="10"
				data-pagefind-meta="title"
			>
				{entry.data.title}
			</h1>

			{
				entry.data.description && (
					<p class="article-description">
						{entry.data.description}
					</p>
				)
			}

			<div class="article-details">
				<time datetime={entry.data.published.toISOString()}>
					{entry.data.published.toLocaleDateString("en-CA", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>

				<span aria-hidden="true">·</span>

				<span>
					{remarkPluginFrontmatter.minutes}
					{remarkPluginFrontmatter.minutes === 1
						? " minute"
						: " minutes"}
				</span>

				<span aria-hidden="true">·</span>

				<span>{remarkPluginFrontmatter.words} words</span>
			</div>

			{
				entry.data.tags?.length > 0 && (
					<div class="article-tags">
						{entry.data.tags.map((tag) => <span>{tag}</span>)}
					</div>
				)
			}
		</header>

		{
			entry.data.image && (
				<ImageWrapper
					id="post-cover"
					src={entry.data.image}
					basePath={path.join(
						"content/posts/",
						getDir(entry.id),
					)}
					class="article-cover"
				/>
			)
		}

		<div class="article-rule"></div>

		<Markdown class="article-content markdown-content">
			<Content />
		</Markdown>

		{
			licenseConfig.enable && (
				<License
					title={entry.data.title}
					slug={entry.slug}
					pubDate={entry.data.published}
					class="article-license"
				/>
			)
		}
	</article>

	<nav class="article-navigation" aria-label="Adjacent articles">
		{
			entry.data.nextSlug ? (
				<a href={getPostUrlBySlug(entry.data.nextSlug)}>
					<span class="article-navigation__label">
						← Previous
					</span>
					<span>{entry.data.nextTitle}</span>
				</a>
			) : (
				<span></span>
			)
		}

		{
			entry.data.prevSlug && (
				<a
					class="article-navigation__next"
					href={getPostUrlBySlug(entry.data.prevSlug)}
				>
					<span class="article-navigation__label">
						Next →
					</span>
					<span>{entry.data.prevTitle}</span>
				</a>
			)
		}
	</nav>
</MainGridLayout>

<style>
	.article-shell {
		width: min(100%, 58rem);
		margin: 0 auto 2rem;
		padding: 4.5rem 5rem 5rem;

		background: var(--article-paper, #f7f3e8);
		color: var(--article-ink, #202124);

		border: 1px solid #d7d0c3;
		border-radius: 0;
		box-shadow: none;

		font-family:
			"Source Serif 4 Variable",
			Georgia,
			"Times New Roman",
			serif;
	}

	.article-back {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 4rem;

		color: #66686d;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
	}

	.article-back:hover {
		color: #172b4d;
	}

	.article-back span {
		transition: transform 160ms ease;
	}

	.article-back:hover span {
		transform: translateX(-0.2rem);
	}

	.article-header {
		max-width: 47rem;
		margin: 0 auto;
		text-align: center;
	}

	.article-type {
		margin: 0 0 1.25rem;

		color: #172b4d;
		font-size: 0.76rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.article-header h1 {
		margin: 0;

		color: #202124;
		font-family: inherit;
		font-size: clamp(2.75rem, 6vw, 4.8rem);
		font-weight: 470;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.article-description {
		max-width: 42rem;
		margin: 1.5rem auto 0;

		color: #66686d;
		font-size: 1.18rem;
		line-height: 1.7;
	}

	.article-details {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;

		margin-top: 1.75rem;

		color: #77736c;
		font-size: 0.88rem;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem 1.25rem;

		margin-top: 1.25rem;

		color: #555860;
		font-size: 0.85rem;
	}

	.article-tags span:not(:last-child)::after {
		content: "·";
		margin-left: 1.25rem;
		color: #b4ad9f;
	}

	.article-cover {
		display: block;
		margin: 3rem auto 0;
		border-radius: 0 !important;
	}

	.article-rule {
		width: 5rem;
		height: 1px;
		margin: 3.5rem auto;

		background: #b8b0a2;
	}

	.article-license {
		margin-top: 4rem;
		border-radius: 0 !important;
	}

	.article-navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;

		width: min(100%, 58rem);
		margin: 0 auto 2rem;
	}

	.article-navigation a {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;

		padding: 1.5rem 0;

		border-top: 1px solid var(--journal-rule);

		color: var(--journal-ink);
		text-decoration: none;
	}

	.article-navigation a:hover {
		color: var(--journal-navy);
	}

	.article-navigation__next {
		text-align: right;
	}

	.article-navigation__label {
		color: var(--journal-muted);
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (max-width: 760px) {
		.article-shell {
			padding: 3rem 1.5rem 3.5rem;
			border-left: 0;
			border-right: 0;
		}

		.article-back {
			margin-bottom: 3rem;
		}

		.article-header h1 {
			font-size: clamp(2.4rem, 12vw, 3.5rem);
		}

		.article-navigation {
			grid-template-columns: 1fr;
			padding: 0 1.5rem;
		}

		.article-navigation__next {
			text-align: left;
		}
	}

/* Article Content Style Specs */

:global(.article-content) {
	max-width: 43rem;
	margin: 0 auto;
	color: #202124 !important;
	font-size: 1.08rem;
	line-height: 1.78;
}

:global(.article-content),
:global(.article-content p),
:global(.article-content li),
:global(.article-content em),
:global(.article-content span) {
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	opacity: 1 !important;
}

:global(.article-content h2) {
	margin-top: 2.8em;
	margin-bottom: 0.9em;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-size: 1.8rem;
	font-weight: 600;
	line-height: 1.2;
	opacity: 1 !important;
}

:global(.article-content h3) {
	margin-top: 2.2em;
	margin-bottom: 0.75em;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-size: 1.45rem;
	font-weight: 600;
	line-height: 1.25;
	opacity: 1 !important;
}

:global(.article-content p) {
	margin: 1.15em 0;
}

:global(.article-content ul),
:global(.article-content ol) {
	margin: 1.3rem 0;
	padding-left: 1.6rem;
}

:global(.article-content li) {
	margin: 0.45rem 0;
}

:global(.article-content hr) {
	width: 5rem;
	margin: 3rem auto;
	border: 0;
	border-top: 1px solid #b8b0a2;
}

:global(.article-content strong) {
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-weight: 650;
}

:global(.article-content a) {
	color: #172b4d !important;
	-webkit-text-fill-color: #172b4d;
	text-decoration-thickness: 1px;
	text-underline-offset: 0.15em;
}

:global(.article-content blockquote) {
	margin: 2rem 0;
	padding: 0.25rem 0 0.25rem 1.5rem;
	border-left: 2px solid #172b4d;
	color: #56585e !important;
	-webkit-text-fill-color: #56585e;
	font-style: italic;
	opacity: 1 !important;
}

:global(.article-content code) {
	padding: 0.12em 0.3em;
	background: #ece6d9;
	border-radius: 2px;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-size: 0.9em;
}

:global(.article-content table) {
	width: 100%;
	margin: 2rem 0;
	border-collapse: collapse;
}

:global(.article-content th),
:global(.article-content td) {
	padding: 0.75rem;
	border-bottom: 1px solid #cfc7b8;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	text-align: left;
}

:global(.article-content th) {
	color: #172b4d !important;
	-webkit-text-fill-color: #172b4d;
	font-weight: 650;
}

:global(.article-content .katex-display) {
	margin: 2rem 0;
	overflow-x: auto;
	overflow-y: hidden;
}

/* Mathematical environments */

:global(.article-content .math-environment) {
	margin: 2.4rem 0;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
}

:global(.article-content .math-environment__title) {
	margin-bottom: 0.75rem;
	color: #172b4d !important;
	-webkit-text-fill-color: #172b4d;
	font-weight: 650;
	line-height: 1.3;
}

:global(.article-content .math-environment__body),
:global(.article-content .math-environment__body p),
:global(.article-content .math-environment__body li),
:global(.article-content .math-environment__body span) {
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
}

:global(.article-content .math-environment__body p:first-child) {
	margin-top: 0;
}

:global(.article-content .math-environment__body p:last-child) {
	margin-bottom: 0;
}

/* Theorem-style results */

:global(.article-content .math-environment--theorem),
:global(.article-content .math-environment--lemma),
:global(.article-content .math-environment--proposition),
:global(.article-content .math-environment--corollary) {
	padding: 1.4rem 1.5rem 1.5rem;
	border-top: 1px solid #9d9587;
	border-bottom: 1px solid #c9c1b3;
	font-style: italic;
}

:global(
	.article-content
	.math-environment--theorem
	.math-environment__title
),
:global(
	.article-content
	.math-environment--lemma
	.math-environment__title
),
:global(
	.article-content
	.math-environment--proposition
	.math-environment__title
),
:global(
	.article-content
	.math-environment--corollary
	.math-environment__title
) {
	font-style: normal;
}

/* Definitions */

:global(.article-content .math-environment--definition) {
	padding: 1.25rem 1.5rem;
	border-left: 3px solid #172b4d;
	background: rgb(236 230 217 / 35%);
}

/* Remarks, examples, and exercises */

:global(.article-content .math-environment--remark),
:global(.article-content .math-environment--example),
:global(.article-content .math-environment--exercise) {
	padding: 1.25rem 1.5rem;
	border-top: 1px solid #d1c9ba;
	border-bottom: 1px solid #d1c9ba;
	background: rgb(236 230 217 / 28%);
}

:global(
	.article-content
	.math-environment--remark
	.math-environment__title
) {
	font-style: italic;
}

/* Proofs */

:global(.article-content .math-environment--proof) {
	margin: 2rem 0 2.6rem;
	padding: 0;
	border: 0;
	background: transparent;
}

:global(
	.article-content
	.math-environment--proof
	.math-environment__title
) {
	display: inline;
	margin: 0;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-style: italic;
	font-weight: 600;
}

:global(
	.article-content
	.math-environment--proof
	.math-environment__title::after
) {
	content: ".";
}

:global(
	.article-content
	.math-environment--proof
	.math-environment__body
) {
	display: inline;
}

:global(
	.article-content
	.math-environment--proof
	.math-environment__body
	> p:first-child
) {
	display: inline;
}

:global(.article-content .math-environment__qed) {
	float: right;
	margin-left: 1rem;
	color: #202124 !important;
	-webkit-text-fill-color: #202124;
	font-style: normal;
}
</style>